    <PackageReference Include="FluentAssertions" Version="8.5.0" />
    <!-- Explicit FHIR reference: FhirPatientModelTests uses Hl7.Fhir.Model directly rather than
         relying on it arriving transitively through the 04-Data-Mapping-ETL project reference. -->
    <PackageReference Include="Hl7.Fhir.R4" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared-Library\HealthDataInteropSharedLibrary.csproj" />
    <ProjectReference Include="..\04-Data-Mapping-ETL\04-Data-Mapping-ETL.csproj" />
    <!-- Added for SmartOnFhirAuthService and OidcOptions tests -->
    <ProjectReference Include="..\05-SMART-on-FHIR\05-SMART-on-FHIR.csproj" />
    <!-- Added for UsCoreConformanceChecker tests -->
    <ProjectReference Include="..\03-Resource-Validator\03-Resource-Validator.csproj" />
  </ItemGroup>

</Project>
