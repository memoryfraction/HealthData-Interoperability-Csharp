<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HealthData.Interop.Logging.Extensions</PackageId>
    <Version>1.0.1</Version>
    <Authors>Rong(Rex) Fan</Authors>
    <Company>Rong(Rex) Fan</Company>
    <Copyright>(c) Rong(Rex) Fan. All rights reserved.</Copyright>
    <Description>Bridge between IApplicationLogger (HealthData.Interop.Abstractions) and Microsoft.Extensions.Logging.ILogger. Provides IApplicationLoggerBridge and ToIApplicationLogger() extension. Supports NLog, Serilog, or any ILogger provider with automatic PHI masking.</Description>
    <PackageTags>fhir;hipaa;logging;bridge;extensions;serilog;nlog;csharp;dotnet</PackageTags>
    <PackageProjectUrl>https://memoryfraction.github.io/HealthData-Interoperability-Csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/memoryfraction/HealthData-Interoperability-Csharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReleaseNotes>v1.0.0 - Initial release: IApplicationLoggerBridge, ToIApplicationLogger extension.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\HealthData.Interop.Abstractions\HealthData.Interop.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>
</Project>
